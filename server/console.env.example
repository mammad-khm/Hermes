# Created by `python3 hermes_console.py init`. Edit and restart the service to apply.

# Login
CONSOLE_USERNAME=admin
# Generate with: python3 hermes_console.py hash-password
CONSOLE_PASSWORD_HASH=
# Random signing secret for login tokens (keep private)
CONSOLE_SECRET=

# Network (use 127.0.0.1 when behind Caddy/nginx)
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8787
CONSOLE_TOKEN_TTL_HOURS=720
# Allowed browser origins for cross-origin clients (native wrappers); * allows any
CONSOLE_CORS_ORIGINS=*

# Hermes
HERMES_HOME=~/.hermes
HERMES_API_URL=http://127.0.0.1:8642
# HERMES_BIN=/home/you/.local/bin/hermes

# Files: the bots' shared workspace and any extra folders to show in Files
CONSOLE_WORKSPACE=~/hermes-workspace
# FILES_ROOTS=~/projects,~/Documents
